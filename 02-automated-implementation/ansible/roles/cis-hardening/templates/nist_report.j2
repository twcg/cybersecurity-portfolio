<!DOCTYPE html>
<html>
<head>
    <title>NIST 800-53 Compliance - {{ inventory_hostname }}</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; }
        .compliant { color: #28a745; font-weight: bold; }
        .control { margin: 10px 0; padding: 10px; border-left: 4px solid #007cba; }
        .evidence { background: #f8f9fa; padding: 8px; margin: 5px 0; }
    </style>
</head>
<body>
    <h1>NIST 800-53 Automated Compliance Report</h1>
    <p><strong>System:</strong> {{ inventory_hostname }}</p>
    <p><strong>Generated:</strong> {{ ansible_date_time.iso8601 }}</p>
    <p><strong>Ansible Playbook:</strong> hardening-playbook.yml</p>
    
    <h2>Compliance Summary</h2>
    <p>Total Controls Mapped: {{ nist_800_53_controls | length }}</p>
    <p>Controls Implemented: {{ nist_800_53_controls | dict2items | selectattr('value.implemented') | list | length }}</p>
    <p>Automated via Ansible: {{ nist_800_53_controls | dict2items | selectattr('value.automated') | list | length }}</p>
    
    <h2>Control Implementation Details</h2>
    {% for control_id, control_data in nist_800_53_controls.items() %}
    <div class="control">
        <h3>{{ control_id }} - {{ control_data.name }}</h3>
        <p><span class="compliant">✅ IMPLEMENTED</span> | Automated: {{ "✅ YES" if control_data.automated else "❌ NO" }}</p>
        
        <div class="evidence">
            <strong>Evidence File:</strong> {{ control_data.evidence }}<br>
            <strong>CIS Controls:</strong>
            <ul>
            {% for cis_control in control_data.cis_controls %}
                <li>{{ cis_control }}</li>
            {% endfor %}
            </ul>
        </div>
    </div>
    {% endfor %}
    
    <h2>Portfolio Evidence</h2>
    <p>This report demonstrates automated NIST 800-53 compliance using existing Ansible infrastructure.</p>
    <p><em>Generated by automated compliance framework</em></p>
</body>
</html>